<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Attendance"
             xmlns:conv="clr-namespace:Attendance.Converters"
             x:Class="Attendance.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:BoolToShowHideConverter x:Key="BoolToShowHideConverter" />
            <conv:SchedulerStateToColorConverter x:Key="SchedulerStateToColorConverter" />
            <conv:ExecutionResultToColorConverter x:Key="ExecutionResultToColorConverter" />
            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
